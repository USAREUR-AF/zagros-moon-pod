# moon-pod — compose environment.
# Copy to .env and populate. first-boot.sh writes this from the active profile + the bundle.
# .env is NOT committed (secrets + per-deployment values).

# Where the pod keeps state (certs, rocksdb, goat-cli profile, doctor output).
# MUST live on the partner's LUKS-encrypted volume.
POD_STATE_DIR=/var/lib/goat-moon

# Partner namespace prefix for the key-exprs (e.g. release/<partner>, or a sandbox slot prefix).
PARTNER_NAMESPACE=release/example-partner

# Stable id for this pod — audit-sink AUDIT_SUBSCRIBER_ID + metric label.
POD_ID=moon-pod

# Endpoint the audit-sink connects to (the local router). MUST be the router's MESH IP, not
# loopback — the audit-sink is a mode:client Zenoh peer, and on network_mode:host a loopback
# endpoint makes it attempt its own TLS listener on :7447, which zenohd already owns.
# first-boot.sh resolves the mesh IP via `netbird status` and writes it here.
ZENOH_LOCAL_ENDPOINT=tls/<mesh-ip>:7447

# Local router listen port — the router healthcheck probes it. 7447 unless the active profile
# overrides it; first-boot.sh writes the effective value.
ZENOH_LISTEN_PORT=7447

# Logging.
ZENOH_LOG=info

# NOTE: the goat-client mesh mode is NOT a compose value. It lives in the active profile
# (profiles/<name>/profile.env, GOAT_CLIENT_MODE) and is consumed by first-boot's host
# goat-clientd step; compose reads nothing from it.
